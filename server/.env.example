# ---------- Core ----------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/canteen
JWT_SECRET=<a long random string, e.g. output of: openssl rand -hex 32>
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ---------- Email OTP (optional, e.g. Gmail app password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Glassify Canteen <you@gmail.com>"

# ---------- SMS OTP (optional, Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Image hosting (optional, Cloudinary) ----------
# Without these, images are stored as base64 in MongoDB (fine for demos).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
